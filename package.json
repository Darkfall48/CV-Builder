{
  "name": "cv-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://darkfall48.github.io/CV-Builder",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "smoke:docx": "esbuild scripts/smoke-docx.mjs --bundle --platform=node --format=esm --outfile=scripts/smoke.bundle.mjs --external:jszip --external:docx --log-level=warning && node scripts/smoke.bundle.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "i18next": "^25.4.0",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "gh-pages": "^6.3.0",
    "sass": "^1.91.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
